root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
# @Composable functions are PascalCase by the framework's own convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Off until switched on: the rule implements OnlyWhenEnabledInEditorconfig, so five imports left
# behind by moving a class out of a file passed every gate this branch ran.
ktlint_standard_no-unused-imports = enabled

[*.gradle.kts]
# Version-catalog access reads as one thought — `libs.versions.x.get().toInt()`
# is clearer on one line than exploded over four.
ktlint_standard_chain-method-continuation = disabled

[*.{yml,yaml,json}]
indent_size = 2

# The generated client. ktlint is switched off for it rather than filtered in Gradle, because
# this is the mechanism ktlint itself reads and it applies to every entry point — the gate, the
# IDE and a hook alike. Measured: 1868 findings against files whose own header says «Do not edit
# this file manually», and formatting them would be undone by the next regeneration, which
# openApiDrift then fails on.
[**/src/commonMain/generated/app/cadence/shared/api/**.kt]
ktlint = disabled
