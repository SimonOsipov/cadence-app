# Copy to .env for local development. Real values live in Railway variables and
# never in the repository.

# Request-path pool: cadence_app. Owns nothing, cannot bypass RLS, and does not
# inherit its granted roles — it reaches tables only by impersonating
# cadence_authenticated inside a transaction.
#
# The chain creates the role without a password: the credential is provisioned
# outside the repository, in Railway and Supabase variables. Locally that is
# what `make dev-up` does — bring up the container, apply the chain, and set the
# password below. `make run` before it will fail to connect, and should.
DATABASE_URL=postgres://cadence_app:cadence_app@localhost:5433/cadence?sslmode=disable

# Migration pool: the role that owns the schema. Used only by cmd/migrate, never
# by the API. Locally this is the bootstrap superuser of the dev container; on
# Supabase it is `postgres`, which has CREATEROLE and is not a superuser.
DATABASE_MIGRATION_URL=postgres://cadence:cadence@localhost:5433/cadence?sslmode=disable

# Service-role pool. System jobs only — reminder sweep, invitations, push
# fan-out. Left empty until the first such job exists.
DATABASE_SERVICE_URL=

MIGRATIONS_PATH=migrations

# Supabase token verification. Both are required: an unset value stops the
# process, because the one thing "no issuer configured" must never mean is "no
# authentication".
#
# The JWKS address is NOT a variable. It is derived as {issuer}/.well-known/jwks.json,
# so no deployment can point the key source at one project while the issuer
# check names another — which would accept tokens from somebody else's Supabase.
#
# The issuer is the project's auth URL, printed in Settings → API. Locally,
# point it at the cadence-dev project: there is no offline stand-in, and a token
# has to come from somewhere. SKL-01 creates that project and confirms which
# signing algorithm it uses; the API accepts RS256 and ES256 and nothing else.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Supabase sets this to "authenticated" in every project. It is checked because
# the contract declares it — it is not tenant isolation, which comes from the
# issuer and the identity of the signing keys.
SUPABASE_JWT_AUDIENCE=authenticated

SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# Comma-separated. Default is the Vite dev server of the doctor dashboard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
