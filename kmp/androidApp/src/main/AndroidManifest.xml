<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup stays off: this app holds clinical data and session tokens
         in private storage, and the platform default would copy both into the
         user's cloud backup and into device-to-device transfer. -->
    <application
        android:name=".CadenceApplication"
        android:allowBackup="false"
        android:label="Cadence"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- singleTop is what makes onNewIntent fire: with the default the system stacks a second
             copy of this activity on a repeated link, and the running one never hears it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where an invitation lands. BROWSABLE is what lets a mail client hand the
                 link over; without it the message opens nothing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cadence" android:host="accept" />
            </intent-filter>
        </activity>
    </application>

</manifest>
