{
  "components": {
    "schemas": {
      "CreatedPatient": {
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "description": "The patient's id. The same value the invitation link signs the person in as.",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      },
      "CreatedProvider": {
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "description": "The doctor's id. The same value the invitation link signs them in as.",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "description": "When the presented token stops being accepted.",
            "format": "date-time",
            "type": "string"
          },
          "full_name": {
            "description": "The caller's name as the clinic wrote it. Absent for an account the clinic holds no profile for.",
            "type": "string"
          },
          "role": {
            "description": "The product role the token asserts, from the cadence_role claim: patient, doctor or admin. Empty when the account has no profile yet, in which case no data endpoint will answer for it.",
            "type": "string"
          },
          "sub": {
            "description": "The caller's user id. Every access policy is keyed on it.",
            "type": "string"
          }
        },
        "required": [
          "sub",
          "role",
          "expires_at"
        ],
        "type": "object"
      },
      "NewPatientBody": {
        "additionalProperties": false,
        "properties": {
          "date_of_birth": {
            "format": "date",
            "type": "string"
          },
          "email": {
            "description": "Where the invitation is sent. Stored folded to lower case, which is the spelling the identity provider holds.",
            "format": "email",
            "maxLength": 320,
            "type": "string"
          },
          "full_name": {
            "description": "The patient's name as the clinic writes it.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "height_cm": {
            "description": "Height in centimetres.",
            "format": "double",
            "minimum": 0,
            "type": "number"
          },
          "sex": {
            "enum": [
              "male",
              "female"
            ],
            "type": "string"
          },
          "specialists": {
            "description": "The care team. A doctor creating a patient has to be on it; an admin names whoever the clinic decided.",
            "items": {
              "$ref": "#/components/schemas/SpecialistBody"
            },
            "minItems": 1,
            "type": [
              "array",
              "null"
            ]
          },
          "target_weight_kg": {
            "description": "Target weight in kilograms.",
            "format": "double",
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "email",
          "full_name",
          "specialists"
        ],
        "type": "object"
      },
      "NewProviderBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "Where the invitation is sent. Stored folded to lower case, which is the spelling the identity provider holds.",
            "format": "email",
            "maxLength": 320,
            "type": "string"
          },
          "full_name": {
            "description": "The doctor's name as the clinic writes it.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title_ru": {
            "description": "What the clinic calls them, in Russian. Shown to a patient beside the name on their care team.",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "email",
          "full_name"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "An explanation specific to this occurrence.",
            "type": "string"
          },
          "errors": {
            "description": "Per-field detail, present on validation failures.",
            "items": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "The request path this problem occurred on.",
            "type": "string"
          },
          "request_id": {
            "description": "Correlates this response with the server log.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the problem type, stable across occurrences.",
            "type": "string"
          },
          "type": {
            "description": "A URI reference identifying the problem type.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ProblemDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the problem is, e.g. body.dose.value.",
            "type": "string"
          },
          "message": {
            "description": "What is wrong with the value at this location.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "RosterPage": {
        "additionalProperties": false,
        "properties": {
          "next_cursor": {
            "description": "Pass as cursor for the following page. Absent on the last one.",
            "type": "string"
          },
          "patients": {
            "description": "The patients this caller may see, ordered by name.",
            "items": {
              "$ref": "#/components/schemas/RosterRow"
            },
            "type": "array"
          }
        },
        "required": [
          "patients"
        ],
        "type": "object"
      },
      "RosterRow": {
        "additionalProperties": false,
        "properties": {
          "age": {
            "description": "Years, worked out by the server. Absent when the clinic has not entered a date of birth.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "full_name": {
            "description": "The patient's name as the clinic wrote it.",
            "type": "string"
          },
          "invite_state": {
            "description": "Where the patient is between the invitation and an account they use. Unknown when the identity provider could not be asked.",
            "enum": [
              "accepted",
              "pending",
              "expired",
              "unknown"
            ],
            "type": "string"
          },
          "user_id": {
            "description": "The patient's id, and the key every later request about them is made on.",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "full_name",
          "age",
          "invite_state"
        ],
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "description": "The device's IANA timezone as pg_timezone_names spells it: Europe/Moscow, Asia/Tbilisi.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "timezone"
        ],
        "type": "object"
      },
      "SpecialistBody": {
        "additionalProperties": false,
        "properties": {
          "care_role": {
            "enum": [
              "endo",
              "dietitian",
              "nurse"
            ],
            "type": "string"
          },
          "primary": {
            "description": "The one specialist who leads. At most one per patient.",
            "type": "boolean"
          },
          "provider_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "provider_id",
          "care_role"
        ],
        "type": "object"
      },
      "StaffMember": {
        "additionalProperties": false,
        "properties": {
          "full_name": {
            "description": "The name as the clinic wrote it.",
            "type": "string"
          },
          "role": {
            "description": "doctor or admin.",
            "type": "string"
          },
          "title_ru": {
            "description": "What a patient sees beside the name. Absent when the clinic stated none.",
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "description": "The identifier a care-team assignment names.",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "full_name",
          "role",
          "title_ru"
        ],
        "type": "object"
      },
      "StaffPage": {
        "additionalProperties": false,
        "properties": {
          "staff": {
            "description": "Everyone who may be put on a care team, ordered by name.",
            "items": {
              "$ref": "#/components/schemas/StaffMember"
            },
            "type": "array"
          }
        },
        "required": [
          "staff"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "An access token from the project's identity provider. Verified against its JWK Set on every request.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Cadence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/dashboard/overview": {
      "get": {
        "description": "The doctor's registry, on the route §11 names and the one M6 extends rather than replaces. A doctor is answered their assigned patients and an administrator everyone; the selection is the database's, so reassigning a patient changes the answer with no query edit. Paging is by cursor rather than by offset, because the set changes underneath a doctor as assignments do. Answers 400 for a cursor this server did not issue, 403 to a patient, and 503 when the database could not serve the request.",
        "operationId": "dashboard-overview",
        "parameters": [
          {
            "description": "Where to continue from, as the previous page's next_cursor. Absent asks for the first page.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Where to continue from, as the previous page's next_cursor. Absent asks for the first page.",
              "maxLength": 1116,
              "type": "string"
            }
          },
          {
            "description": "How many patients the page carries.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 8,
              "description": "How many patients the page carries.",
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterPage"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "The patients this member of staff may see",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Returns the identity the presented token carries, and the caller's own name. The role is the token's: changed in the database, it takes effect when the token expires. The name is read from the caller's own profile row, because nothing else in the API answers a person their own name — it is absent for an account the clinic holds no profile for. Answers 503 when the database could not serve the request.",
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "The authenticated caller",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/me/session": {
      "post": {
        "description": "Records the caller's timezone against their profile. A patient's is stored — the schedule, the reminders and the server-side sweep all read it — and the zone is validated there; a doctor's and an administrator's are not stored, and the call is answered without a write rather than refused, so one client can serve every role. Answers 400 when a patient's zone is not one the server knows, 403 when the account has no role yet, and 503 when the database could not serve the request.",
        "operationId": "record-session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Report the device's timezone",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/patients": {
      "post": {
        "description": "Creates the patient and sends the invitation as one action: the address is invited at the identity provider, and the profile, the card, the care team, the preferences and the record of the invitation are written against the identifier it assigned. The server sets the role; there is no public registration. Answers 403 when the caller may not create patients or is not on the care team they wrote, 409 when the address already belongs to a patient or to an account this clinic did not invite, 422 when the body says something the schema cannot refuse — two leading specialists, one named twice, somebody who is not a provider — and 503 when the provisioner is unreachable.",
        "operationId": "create-patient",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPatientBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedPatient"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a patient and invite them",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/providers": {
      "get": {
        "description": "Everyone a care team may name: the clinic's doctors and administrators, by name and by the title a patient reads beside it. Staff only — a patient is answered their own care team by the screen that draws it, not this list. The read is authorised here rather than by a policy: no policy lets a doctor read a colleague's profile, which is why the new-patient form had nobody to offer. Answers 403 to a patient and 503 when the database could not serve the request.",
        "operationId": "list-providers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffPage"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "The clinic's staff",
        "tags": [
          "identity"
        ]
      },
      "post": {
        "description": "Creates the doctor and sends the invitation as one action, the way a patient is created. Administrators only, and doctors only: the clinic's first administrator comes into being through a one-off command under the migration role, and the database refuses any other role from this path. Answers 403 to a caller who is not an administrator, 409 when the address already belongs to somebody this clinic knows or to an account it did not invite, 422 when the address folds to nothing, and 503 when the provisioner is unreachable.",
        "operationId": "create-provider",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProviderBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedProvider"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Take a doctor on and invite them",
        "tags": [
          "identity"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
