# Copy to .env for local development. Real values live in the deployment's own
# variable store and never in the repository.

# Request-path pool: cadence_app. Owns nothing, cannot bypass RLS, and does not
# inherit its granted roles — it reaches tables only by impersonating one of the
# three product roles (cadence_patient, cadence_doctor, cadence_admin) inside a
# transaction. Which one is decided by the caller's role through a closed map in
# the seam, never by a value from the token.
#
# The chain creates the role without a password: the credential is provisioned
# outside the repository, in the deployment's variables. Locally that is what
# `make dev-up` does — bring up the container, apply the chain, and set the
# password below. `make run` before it will fail to connect, and should.
#
# The chain also creates cadence_service_app, the service path's own LOGIN role
# for DATABASE_SERVICE_URL. `make dev-up` does not give it a password yet: the
# second pool arrives with the step that builds it.
DATABASE_URL=postgres://cadence_app:cadence_app@localhost:5433/cadence?sslmode=disable

# Migration pool: the role that owns the schema. Used only by cmd/migrate, never
# by the API. Locally this is the bootstrap superuser of the dev container; on
# managed Postgres the role handed out has CREATEROLE and is not a superuser,
# and the chain is written for exactly that.
DATABASE_MIGRATION_URL=postgres://cadence:cadence@localhost:5433/cadence?sslmode=disable

# Service-path pool: cadence_service_app. The writes no policy lets a request
# make — creating a patient, entering clinical fields, recording an invitation —
# each of which is audited. A second connection rather than a second statement:
# the boundary between the paths runs along session_user, so a bug on one cannot
# reach the other's grants.
#
# Required, and required to differ from DATABASE_URL. pgx does not treat an empty
# connection string as absent — it falls through to libpq's defaults, which
# resolve to the local user, and in a container that is the superuser. The
# password below is the one `make dev-up` sets, for the same reason as the one
# above.
DATABASE_SERVICE_URL=postgres://cadence_service_app:cadence_service_app@localhost:5433/cadence?sslmode=disable

MIGRATIONS_PATH=migrations

# Token verification. Both are required: an unset value stops the process,
# because the one thing "no issuer configured" must never mean is "no
# authentication".
#
# The JWKS address is NOT a variable. It is derived as {issuer}/.well-known/jwks.json,
# so no deployment can point the key source at one provider while the issuer
# check names another — which would accept tokens minted by somebody else.
#
# The issuer is our own GoTrue, deployed alongside the API (SKL-06). It must be
# configured to sign asymmetrically via GOTRUE_JWT_KEYS: the API accepts ES256
# and RS256 and nothing else, so a GoTrue left on the legacy shared secret
# (HS256) will have every one of its tokens refused.
#
# There is no offline stand-in — a token has to come from somewhere — so local
# development points at the dev deployment.
# Locally this is the GoTrue in docker-compose.yml, served at the bare origin —
# the /auth/v1 prefix familiar from Supabase comes from their gateway, not from
# GoTrue itself. `make dev-up` brings it up.
AUTH_JWT_ISSUER=http://localhost:9999

# GoTrue sets this to "authenticated" for every user. It is checked because the
# contract declares it — it is not tenant isolation, which comes from the issuer
# and the identity of the signing keys.
AUTH_JWT_AUDIENCE=authenticated

# The closed list of key ids (comma-separated) this process accepts for a
# session token. Mandatory, and an empty value stops the process: "no
# permitted key ids configured" must never be read as "trust whatever the key
# set publishes" — a token naming any other kid is refused in keyfunc, before
# the key set is ever consulted. Matches the session key's kid in
# docker-compose.yml's GOTRUE_JWT_KEYS (the one with key_ops: ["sign"]).
#
# Rotation order, walked through against the JWKS fixture by
# internal/platform/auth/token/verifier_test.go (not against a real GoTrue,
# which is step-2's contract-test territory): add the new kid here → deploy
# the API → hand GoTrue the signing marker for the new key → hold the old kid
# here for at least the refresh-token lifetime → remove the old kid.
AUTH_JWT_SESSION_KIDS=a1323fc3-c42d-37ae-8be6-1ebfb524403f

# The admin key's kid — held only by provisioner, never by this process — so
# that Load can refuse a AUTH_JWT_SESSION_KIDS value that names it. Were the
# admin kid ever a permitted session key id, a compromised provisioner would
# turn its admin key into an accepted session token in one step, which is the
# one barrier this pinning exists to provide. Matches the second entry in
# docker-compose.yml's GOTRUE_JWT_KEYS (the one with no key_ops).
AUTH_JWT_ADMIN_KID=xr8-HA0zUfG0zdB40mJdFNwX3DvkinwdnhXB1g2W_Dw

SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# Comma-separated. Default is the Vite dev server of the doctor dashboard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
