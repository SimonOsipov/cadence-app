{
  "components": {
    "schemas": {
      "CreatedPatient": {
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "description": "The patient's id. The same value the invitation link signs the person in as.",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "description": "When the presented token stops being accepted.",
            "format": "date-time",
            "type": "string"
          },
          "role": {
            "description": "The product role the token asserts, from the cadence_role claim: patient, doctor or admin. Empty when the account has no profile yet, in which case no data endpoint will answer for it.",
            "type": "string"
          },
          "sub": {
            "description": "The caller's user id. Every access policy is keyed on it.",
            "type": "string"
          }
        },
        "required": [
          "sub",
          "role",
          "expires_at"
        ],
        "type": "object"
      },
      "NewPatientBody": {
        "additionalProperties": false,
        "properties": {
          "date_of_birth": {
            "format": "date",
            "type": "string"
          },
          "email": {
            "description": "Where the invitation is sent. Stored folded to lower case, which is the spelling the identity provider holds.",
            "format": "email",
            "maxLength": 320,
            "type": "string"
          },
          "full_name": {
            "description": "The patient's name as the clinic writes it.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "height_cm": {
            "description": "Height in centimetres.",
            "format": "double",
            "minimum": 0,
            "type": "number"
          },
          "sex": {
            "enum": [
              "male",
              "female"
            ],
            "type": "string"
          },
          "specialists": {
            "description": "The care team. A doctor creating a patient has to be on it; an admin names whoever the clinic decided.",
            "items": {
              "$ref": "#/components/schemas/SpecialistBody"
            },
            "minItems": 1,
            "type": [
              "array",
              "null"
            ]
          },
          "target_weight_kg": {
            "description": "Target weight in kilograms.",
            "format": "double",
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "email",
          "full_name",
          "specialists"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "An explanation specific to this occurrence.",
            "type": "string"
          },
          "errors": {
            "description": "Per-field detail, present on validation failures.",
            "items": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "The request path this problem occurred on.",
            "type": "string"
          },
          "request_id": {
            "description": "Correlates this response with the server log.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the problem type, stable across occurrences.",
            "type": "string"
          },
          "type": {
            "description": "A URI reference identifying the problem type.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ProblemDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the problem is, e.g. body.dose.value.",
            "type": "string"
          },
          "message": {
            "description": "What is wrong with the value at this location.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "SpecialistBody": {
        "additionalProperties": false,
        "properties": {
          "care_role": {
            "enum": [
              "endo",
              "dietitian",
              "nurse"
            ],
            "type": "string"
          },
          "primary": {
            "description": "The one specialist who leads. At most one per patient.",
            "type": "boolean"
          },
          "provider_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "provider_id",
          "care_role"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "An access token from the project's identity provider. Verified against its JWK Set on every request.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Cadence API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/me": {
      "get": {
        "description": "Returns the identity carried by the presented token. It reads no database: a role changed there takes effect when the token expires.",
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "The authenticated caller",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/patients": {
      "post": {
        "description": "Creates the patient and sends the invitation as one action: the address is invited at the identity provider, and the profile, the card, the care team, the preferences and the record of the invitation are written against the identifier it assigned. The server sets the role; there is no public registration. Answers 409 when the address already belongs to a patient or to an account this clinic did not invite, and 503 when the provisioner is unreachable.",
        "operationId": "create-patient",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPatientBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedPatient"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a patient and invite them",
        "tags": [
          "identity"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
