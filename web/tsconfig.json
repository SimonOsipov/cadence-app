{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    // Node runs the build-time scripts by stripping types, and it resolves a relative import only
    // with its real extension — so scripts/generate-tokens.ts imports './tokens.ts'. Safe here because
    // nothing in this project emits JavaScript from tsc: noEmit is on and Vite does the building.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // tests/ is the Playwright spec and its teardown — typed and linted here, run by neither Vitest nor
  // the gate. See playwright.config.ts for why it is a command a person runs.
  "include": ["src", "scripts", "tests", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["prototype", "dist", "node_modules"]
}
